{
  "editor.wordWrap": "on",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.search.rootFiles.exclude": ["**/figures/**"],
  "latex-workshop.latex.tools": [
    {
      "name": "make",
      "command": "make",
      "args": ["-C", "%WORKSPACE_FOLDER%/paper"],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "make (figures + document)",
      "tools": ["make"]
    }
  ],
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/paper/build",
  "latex-workshop.latex.jobname": "paper",
  "better-comments.tags": [
    { "tag": "!", "color": "#FF2D00", "backgroundColor": "transparent", "bold": true },
    { "tag": "?", "color": "#3498DB", "backgroundColor": "transparent" },
    { "tag": "todo", "color": "#FF8C00", "backgroundColor": "transparent", "bold": true },
    { "tag": "*", "color": "#98C379", "backgroundColor": "transparent" }
  ]
}
