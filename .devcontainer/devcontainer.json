{
  "name": "microvm-research-trial",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "marimo-team.vscode-marimo",
        "astral-sh.ty",
        "eamodio.gitlens",
        "repreng.csv",
        "anthropic.claude-code",
        "James-Yu.latex-workshop",
        "aaron-bond.better-comments"
      ],
      "settings": {
        "marimo.pythonPath": "/workspaces/microvm-research-trial/.venv/bin/python"
      }
    }
  },

  "forwardPorts": [5173],
  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/root/.ssh"
  ],

  "remoteUser": "root"
}
